{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dioxus-ui component registry entry",
  "type": "object",
  "required": ["name", "description", "files"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathMapping"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathMapping"
      }
    }
  },
  "$defs": {
    "pathMapping": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    }
  }
}
